generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum CollectionSetCondition {
  NEW
  USED
}

enum CollectionSetBuildStatus {
  ASSEMBLED
  DISASSEMBLED
}

enum CollectionSetPartsSource {
  ORIGINAL_SET
  OWNED_PARTS
  MIXED
}

enum CollectionPartSourceType {
  SET
  SPARE_PART
  PURCHASE
  MOC
  OTHER
}

enum ExternalSource {
  REBRICKABLE
  BRICKLINK
  LEGO
  LDRAW
  BRICKOWL
  OTHER
}

// ============================================================
// USER
// ============================================================

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String?
  name         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections Collection[]

  @@map("users")
}

// ============================================================
// COLLECTION
// ============================================================

model Collection {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sets             CollectionSet[]
  parts            CollectionPart[]
  storageLocations StorageLocation[]

  @@index([userId])
  @@map("collections")
}

// ============================================================
// THEMES
// ============================================================

model Theme {
  id String @id @default(uuid()) @db.Uuid

  rebrickableId Int    @unique
  name          String

  parentId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent Theme? @relation("ThemeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children Theme[] @relation("ThemeHierarchy")

  sets Set[]

  @@index([parentId])
  @@index([name])
  @@map("themes")
}

// ============================================================
// PART CATEGORIES
// ============================================================

model PartCategory {
  id String @id @default(uuid()) @db.Uuid

  rebrickableId Int    @unique
  name          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts Part[]

  @@index([name])
  @@map("part_categories")
}

// ============================================================
// COLORS
// ============================================================

model Color {
  id String @id @default(uuid()) @db.Uuid

  rebrickableId Int @unique

  name    String
  rgb     String
  isTrans Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  elements        Element[]
  inventoryParts  InventoryPart[]
  collectionParts CollectionPart[]

  externalIds ExternalColorId[]

  @@index([name])
  @@index([rgb])
  @@map("colors")
}

// ============================================================
// PARTS
// ============================================================

model Part {
  id String @id @default(uuid()) @db.Uuid

  rebrickablePartNum String @unique

  name String

  categoryId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category PartCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  elements        Element[]
  inventoryParts  InventoryPart[]
  collectionParts CollectionPart[]

  parentRelations PartRelationship[] @relation("ParentPart")
  childRelations  PartRelationship[] @relation("ChildPart")

  externalIds ExternalPartId[]

  @@index([categoryId])
  @@index([name])
  @@map("parts")
}

// ============================================================
// ELEMENTS
// ============================================================

model Element {
  id String @id @default(uuid()) @db.Uuid

  rebrickableElementId String @unique

  partId  String @db.Uuid
  colorId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  part  Part  @relation(fields: [partId], references: [id], onDelete: Restrict)
  color Color @relation(fields: [colorId], references: [id], onDelete: Restrict)

  externalIds ExternalElementId[]

  @@index([partId])
  @@index([colorId])
  @@unique([partId, colorId])
  @@map("elements")
}

// ============================================================
// PART RELATIONSHIPS
// ============================================================

model PartRelationship {
  id String @id @default(uuid()) @db.Uuid

  relationshipType String

  parentPartId String @db.Uuid
  childPartId  String @db.Uuid

  createdAt DateTime @default(now())

  parentPart Part @relation("ParentPart", fields: [parentPartId], references: [id], onDelete: Cascade)
  childPart  Part @relation("ChildPart", fields: [childPartId], references: [id], onDelete: Restrict)

  @@unique([relationshipType, parentPartId, childPartId])
  @@index([parentPartId])
  @@index([childPartId])
  @@index([relationshipType])
  @@map("part_relationships")
}

// ============================================================
// SETS
// ============================================================

model Set {
  id String @id @default(uuid()) @db.Uuid

  rebrickableSetNum String @unique

  name     String
  year     Int
  numParts Int?

  themeId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theme Theme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  inventories           Inventory[]
  collectionSets        CollectionSet[]
  inventorySets         InventorySet[]
  collectionPartSources CollectionPartSource[]

  externalIds ExternalSetId[]

  @@index([themeId])
  @@index([year])
  @@index([name])
  @@map("sets")
}

// ============================================================
// INVENTORIES
// ============================================================

model Inventory {
  id String @id @default(uuid()) @db.Uuid

  rebrickableId Int @unique

  version Int

  setId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  set Set @relation(fields: [setId], references: [id], onDelete: Cascade)

  parts    InventoryPart[]
  sets     InventorySet[]
  minifigs InventoryMinifig[]

  @@unique([setId, version])
  @@index([setId])
  @@map("inventories")
}

// ============================================================
// INVENTORY PARTS
// ============================================================

model InventoryPart {
  id String @id @default(uuid()) @db.Uuid

  inventoryId String @db.Uuid
  partId      String @db.Uuid
  colorId     String @db.Uuid

  quantity Int

  isSpare Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id], onDelete: Restrict)
  color     Color     @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([inventoryId, partId, colorId, isSpare])
  @@index([inventoryId])
  @@index([partId])
  @@index([colorId])
  @@map("inventory_parts")
}

// ============================================================
// INVENTORY SETS
// ============================================================

model InventorySet {
  id String @id @default(uuid()) @db.Uuid

  inventoryId String @db.Uuid
  setId       String @db.Uuid

  quantity Int

  createdAt DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  set       Set       @relation(fields: [setId], references: [id], onDelete: Restrict)

  @@unique([inventoryId, setId])
  @@index([inventoryId])
  @@index([setId])
  @@map("inventory_sets")
}

// ============================================================
// MINIFIGS
// ============================================================

model Minifig {
  id String @id @default(uuid()) @db.Uuid

  rebrickableFigNum String @unique

  name     String
  numParts Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories InventoryMinifig[]

  externalIds ExternalMinifigId[]

  @@index([name])
  @@map("minifigs")
}

// ============================================================
// INVENTORY MINIFIGS
// ============================================================

model InventoryMinifig {
  id String @id @default(uuid()) @db.Uuid

  inventoryId String @db.Uuid
  minifigId   String @db.Uuid

  quantity Int

  createdAt DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  minifig   Minifig   @relation(fields: [minifigId], references: [id], onDelete: Restrict)

  @@unique([inventoryId, minifigId])
  @@index([inventoryId])
  @@index([minifigId])
  @@map("inventory_minifigs")
}

// ============================================================
// EXTERNAL PART IDS
// ============================================================

model ExternalPartId {
  id String @id @default(uuid()) @db.Uuid

  partId String @db.Uuid

  source     ExternalSource
  externalId String

  createdAt DateTime @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([partId])
  @@index([source])
  @@map("external_part_ids")
}

// ============================================================
// EXTERNAL COLOR IDS
// ============================================================

model ExternalColorId {
  id String @id @default(uuid()) @db.Uuid

  colorId String @db.Uuid

  source     ExternalSource
  externalId String

  createdAt DateTime @default(now())

  color Color @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([colorId])
  @@index([source])
  @@map("external_color_ids")
}

// ============================================================
// EXTERNAL ELEMENT IDS
// ============================================================

model ExternalElementId {
  id String @id @default(uuid()) @db.Uuid

  elementId String @db.Uuid

  source     ExternalSource
  externalId String

  createdAt DateTime @default(now())

  element Element @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([elementId])
  @@index([source])
  @@map("external_element_ids")
}

// ============================================================
// EXTERNAL SET IDS
// ============================================================

model ExternalSetId {
  id String @id @default(uuid()) @db.Uuid

  setId String @db.Uuid

  source     ExternalSource
  externalId String

  createdAt DateTime @default(now())

  set Set @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([setId])
  @@index([source])
  @@map("external_set_ids")
}

// ============================================================
// EXTERNAL MINIFIG IDS
// ============================================================

model ExternalMinifigId {
  id String @id @default(uuid()) @db.Uuid

  minifigId String @db.Uuid

  source     ExternalSource
  externalId String

  createdAt DateTime @default(now())

  minifig Minifig @relation(fields: [minifigId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([minifigId])
  @@index([source])
  @@map("external_minifig_ids")
}

// ============================================================
// USER COLLECTION - SETS
// ============================================================

model CollectionSet {
  id String @id @default(uuid()) @db.Uuid

  collectionId String @db.Uuid
  setId        String @db.Uuid

  condition   CollectionSetCondition   @default(USED)
  partsSource CollectionSetPartsSource @default(ORIGINAL_SET)
  buildStatus CollectionSetBuildStatus @default(ASSEMBLED)

  isComplete      Boolean @default(true)
  hasBox          Boolean @default(false)
  hasInstructions Boolean @default(false)

  purchasePrice Decimal?  @db.Decimal(12, 2)
  purchaseDate  DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  set        Set        @relation(fields: [setId], references: [id], onDelete: Restrict)

  @@index([collectionId])
  @@index([setId])
  @@index([condition])
  @@index([buildStatus])
  @@map("collection_sets")
}

// ============================================================
// USER'S LOOSE PART INVENTORY
// ============================================================

model CollectionPart {
  id String @id @default(uuid()) @db.Uuid

  collectionId String @db.Uuid
  partId       String @db.Uuid
  colorId      String @db.Uuid

  quantity Int @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  part       Part       @relation(fields: [partId], references: [id], onDelete: Restrict)
  color      Color      @relation(fields: [colorId], references: [id], onDelete: Restrict)

  sources CollectionPartSource[]

  storage ElementStorage[]

  @@unique([collectionId, partId, colorId])
  @@index([collectionId])
  @@index([partId])
  @@index([colorId])
  @@map("collection_parts")
}

// ============================================================
// SOURCE OF USER'S LOOSE PARTS
// ============================================================

model CollectionPartSource {
  id String @id @default(uuid()) @db.Uuid

  collectionPartId String @db.Uuid

  sourceType CollectionPartSourceType

  sourceSetId String? @db.Uuid

  quantity Int

  notes String?

  createdAt DateTime @default(now())

  collectionPart CollectionPart @relation(fields: [collectionPartId], references: [id], onDelete: Cascade)
  sourceSet      Set?           @relation(fields: [sourceSetId], references: [id], onDelete: SetNull)

  @@index([collectionPartId])
  @@index([sourceSetId])
  @@map("collection_part_sources")
}

// ============================================================
// STORAGE LOCATIONS
// ============================================================

model StorageLocation {
  id String @id @default(uuid()) @db.Uuid

  collectionId String  @db.Uuid
  parentId     String? @db.Uuid

  name        String
  code        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parent     StorageLocation? @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children StorageLocation[] @relation("LocationHierarchy")

  elements ElementStorage[]

  @@index([collectionId])
  @@index([parentId])
  @@map("storage_locations")
}

// ============================================================
// PART STORAGE
// ============================================================

model ElementStorage {
  id String @id @default(uuid()) @db.Uuid

  collectionPartId  String @db.Uuid
  storageLocationId String @db.Uuid

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collectionPart  CollectionPart  @relation(fields: [collectionPartId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  @@unique([collectionPartId, storageLocationId])
  @@index([collectionPartId])
  @@index([storageLocationId])
  @@map("element_storage")
}