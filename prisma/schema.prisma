generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SetType {
  SET
  GIFT_WITH_PURCHASE
  PROMOTIONAL
  OTHER
}

enum SetCondition {
  NEW
  USED
  MIXED
}

enum PartsSource {
  ORIGINAL
  REPLACEMENT
  MIXED
}

enum SetBuildStatus {
  NOT_BUILT
  IN_PROGRESS
  BUILT
}

enum ElementType {
  PART
  MINIFIG
  BOOK
  STICKER
  BOX
  OTHER
}

enum SetElementSourceType {
  ORIGINAL_SET
  REPLACEMENT
  OTHER
}

enum CollectionElementSourceType {
  SET
  PURCHASE
  TRADE
  OTHER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections Collection[]

  @@map("users")
}

model Collection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sets     CollectionSet[]
  elements CollectionElement[]

  @@index([userId])
  @@map("collections")
}

model SetClass {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sets Set[]

  @@map("set_classes")
}

model Set {
  id               String       @id @default(uuid()) @db.Uuid
  setNumber        String       @unique
  name             String
  setType          SetType      @default(SET)
  condition        SetCondition @default(NEW)
  partsSource      PartsSource  @default(ORIGINAL)
  buildStatus      SetBuildStatus @default(NOT_BUILT)
  year             Int?
  pieceCount       Int?
  minifigCount     Int?
  imageUrl         String?
  description      String?
  setClassId       String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  setClass SetClass? @relation(fields: [setClassId], references: [id], onDelete: SetNull)

  collectionSets CollectionSet[]
  elements       SetElement[]
  relationsFrom  SetRelation[] @relation("SetRelationParent")
  relationsTo    SetRelation[] @relation("SetRelationChild")

  @@index([setClassId])
  @@index([year])
  @@map("sets")
}

model CollectionSet {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @db.Uuid
  setId        String   @db.Uuid
  quantity     Int      @default(1)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  set        Set        @relation(fields: [setId], references: [id], onDelete: Cascade)

  elements  CollectionSetElement[]
  relationsFrom CollectionSetRelation[] @relation("CollectionSetRelationParent")
  relationsTo   CollectionSetRelation[] @relation("CollectionSetRelationChild")

  @@unique([collectionId, setId])
  @@index([setId])
  @@map("collection_sets")
}

model SetElement {
  id        String   @id @default(uuid()) @db.Uuid
  setId     String   @db.Uuid
  elementId String   @db.Uuid
  quantity  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  set     Set     @relation(fields: [setId], references: [id], onDelete: Cascade)
  element Element @relation(fields: [elementId], references: [id], onDelete: Cascade)

  sources SetElementSource[]

  @@unique([setId, elementId])
  @@index([elementId])
  @@map("set_elements")
}

model CollectionSetElement {
  id                String   @id @default(uuid()) @db.Uuid
  collectionSetId   String   @db.Uuid
  elementId         String   @db.Uuid
  quantity          Int      @default(1)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  collectionSet CollectionSet @relation(fields: [collectionSetId], references: [id], onDelete: Cascade)
  element       Element       @relation(fields: [elementId], references: [id], onDelete: Cascade)

  sources CollectionSetElementSource[]

  @@unique([collectionSetId, elementId])
  @@index([elementId])
  @@map("collection_set_elements")
}

model SetElementSource {
  id           String              @id @default(uuid()) @db.Uuid
  setElementId String              @db.Uuid
  sourceType   SetElementSourceType
  sourceId     String?
  quantity     Int                 @default(1)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  setElement SetElement @relation(fields: [setElementId], references: [id], onDelete: Cascade)

  @@index([setElementId])
  @@map("set_element_sources")
}

model CollectionSetElementSource {
  id                     String                      @id @default(uuid()) @db.Uuid
  collectionSetElementId String                      @db.Uuid
  sourceType              SetElementSourceType
  sourceId                String?
  quantity                Int                         @default(1)
  notes                   String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  collectionSetElement CollectionSetElement @relation(fields: [collectionSetElementId], references: [id], onDelete: Cascade)

  @@index([collectionSetElementId])
  @@map("collection_set_element_sources")
}

model SetRelation {
  id          String   @id @default(uuid()) @db.Uuid
  parentSetId String   @db.Uuid
  childSetId  String   @db.Uuid
  quantity    Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentSet Set @relation("SetRelationParent", fields: [parentSetId], references: [id], onDelete: Cascade)
  childSet  Set @relation("SetRelationChild", fields: [childSetId], references: [id], onDelete: Cascade)

  @@unique([parentSetId, childSetId])
  @@index([childSetId])
  @@map("set_relations")
}

model CollectionSetRelation {
  id               String   @id @default(uuid()) @db.Uuid
  parentCollectionSetId String @db.Uuid
  childCollectionSetId  String @db.Uuid
  quantity         Int      @default(1)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentCollectionSet CollectionSet @relation("CollectionSetRelationParent", fields: [parentCollectionSetId], references: [id], onDelete: Cascade)
  childCollectionSet  CollectionSet @relation("CollectionSetRelationChild", fields: [childCollectionSetId], references: [id], onDelete: Cascade)

  @@unique([parentCollectionSetId, childCollectionSetId])
  @@index([childCollectionSetId])
  @@map("collection_set_relations")
}

model ElementColor {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  rgb       String?
  hex       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  elements Element[]

  @@map("element_colors")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  elements Element[]

  @@map("categories")
}

model Element {
  id            String      @id @default(uuid()) @db.Uuid
  elementNumber String?     @unique
  partNumber    String?
  name          String
  description   String?
  imageUrl      String?
  elementType   ElementType @default(PART)
  categoryId    String?     @db.Uuid
  colorId       String?     @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  color    ElementColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  setElements           SetElement[]
  collectionSetElements CollectionSetElement[]
  collectionElements    CollectionElement[]
  storage               ElementStorage[]

  @@index([categoryId])
  @@index([colorId])
  @@index([partNumber])
  @@map("elements")
}

model CollectionElement {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @db.Uuid
  elementId    String   @db.Uuid
  quantity     Int      @default(1)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  element    Element    @relation(fields: [elementId], references: [id], onDelete: Cascade)

  sources CollectionElementSource[]

  @@unique([collectionId, elementId])
  @@index([elementId])
  @@map("collection_elements")
}

model CollectionElementSource {
  id                  String                       @id @default(uuid()) @db.Uuid
  collectionElementId String                       @db.Uuid
  sourceType          CollectionElementSourceType
  sourceId            String?
  quantity            Int                          @default(1)
  notes               String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  collectionElement CollectionElement @relation(fields: [collectionElementId], references: [id], onDelete: Cascade)

  @@index([collectionElementId])
  @@map("collection_element_sources")
}

model StorageLocation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String?  @unique
  parentId  String?  @db.Uuid
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   StorageLocation?  @relation("StorageLocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children StorageLocation[] @relation("StorageLocationTree")

  elements ElementStorage[]

  @@index([parentId])
  @@map("storage_locations")
}

model ElementStorage {
  id               String   @id @default(uuid()) @db.Uuid
  elementId        String   @db.Uuid
  storageLocationId String  @db.Uuid
  quantity         Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  element        Element        @relation(fields: [elementId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  @@unique([elementId, storageLocationId])
  @@index([storageLocationId])
  @@map("element_storage")
}